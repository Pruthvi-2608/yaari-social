{
  "name": "yaari-social-cafe-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start",
    "dev:admin": "npm --prefix backend/src/admin run dev",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "npm --prefix backend/src/admin run build",
    "start": "npm --prefix backend run start"
  }
}
